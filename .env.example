# ─────────────────────────────────────────────────────────────────────────────
# Aegis CTI — environment configuration
# Copy to `.env` and fill in secrets. NEVER commit the populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change_me_postgres
# Full URL used by API + Rust services
DATABASE_URL=postgres://aegis:change_me_postgres@postgres:5432/aegis

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379/0

# ── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change_me_opensearch
OPENSEARCH_INDEX_PREFIX=aegis

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# Public origin as seen by the browser — this is the caddy mTLS edge now
# (used for notification links / callback URLs). Set to your https://<host>:8443 on a VPS.
API_PUBLIC_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443,http://localhost:5173

# JWT — generate strong random values: `openssl rand -hex 48`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=1209600     # seconds (14d)

# Rate limiting (per IP, sliding window)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60        # seconds

# Seed admin (created on first migration if not present)
SEED_ADMIN_EMAIL=admin@aegis.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Rust services ────────────────────────────────────────────────────────────
RUST_LOG=info,aegis=debug
WORKER_CONCURRENCY=8
SCANNER_MAX_CONCURRENCY=64 # concurrent port probes (memory-safe on 4 GB hosts)
SCANNER_RATE_PPS=2000       # packets/sec cap — be a good netizen

# ── OSINT / Threat-intel API keys (all optional; features degrade gracefully) ─
NVD_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
GREYNOISE_API_KEY=
HIBP_API_KEY=
SECURITYTRAILS_API_KEY=
MISP_URL=
MISP_KEY=
OPENCTI_URL=
OPENCTI_TOKEN=

# ── Alert channels (optional) ────────────────────────────────────────────────
ALERTS_ENABLED=true         # set false to disable the in-process alert engine
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@aegis.local
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Tor (public onion intel only) ────────────────────────────────────────────
TOR_SOCKS_PROXY=socks5h://tor:9050
TOR_ENABLED=false

# ── Flight / Maritime public APIs (optional) ─────────────────────────────────
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AISSTREAM_API_KEY=
