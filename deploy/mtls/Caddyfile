# Aegis CTI — mTLS edge (the ONLY public entrypoint).
#
# TLS 1.2/1.3 with mutual authentication: a client must present a certificate
# issued by the private CA in deploy/mtls/certs (see generate-certs.sh) or the
# handshake is rejected and the app is never reached. No public CA is used, so
# nothing lands in Certificate Transparency logs.
#
# The plain-HTTP dashboard port (web:8080) is intentionally NOT published to the
# host anymore — this edge is the only way in.

:8443 {
	tls /certs/server.crt /certs/server.key {
		client_auth {
			mode require_and_verify_client_certs
			trusted_ca_certs /certs/ca.crt
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# nginx inside the `web` container listens on 8080 (unprivileged) and
	# routes /api and /ws to the API over the internal aegis network.
	reverse_proxy web:8080
}
